<!-- Illustrative definitions matching the lab detections. Review against the exact live server configuration before reuse. -->
<group name="sysmon,custom_detection,">
  <rule id="100101" level="3">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\notepad\.exe$</field>
    <description>LAB: Notepad process creation detected</description>
  </rule>
</group>

<group name="windows,authentication_failed,brute_force,">
  <rule id="100102" level="10" frequency="3" timeframe="60">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>LAB: Multiple failed Windows logons for same user</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>
</group>
